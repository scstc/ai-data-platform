# 纯本地栈(deploy/docker-compose.local.yml)配置。复制为 deploy/.env.local 后按需修改(不入库)。

# PostgreSQL(本地新库,仅用于迁移建表,不含生产数据)
PG_USER=adp
PG_PASSWORD=adp_dev_pw
PG_DB=adp
PG_PORT=55433

# MinIO(本地新建,替代远程 10.60.1.60 的 MinIO)
MINIO_ROOT_USER=adpadmin
MINIO_ROOT_PASSWORD=adpMinio#2026
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 对外 Web 端口
WEB_PORT=8090

# 后端直连端口(Swagger /docs 等,nginx 只反代 /api/ 前缀访问不到;避开本机 /adp-start 常用的 18003)
BACKEND_PORT=18004

# kkFileView(非结构化文件预览:pdf/word/ppt/视频/音频/图片等)
KK_PORT=8012

# 引擎并发
ENGINE_NP=2
ENGINE_CONCURRENCY=3

# 跨域来源(同源部署可不改,默认对齐 WEB_PORT)
CORS_ORIGINS=["http://localhost:8090"]

# 会话令牌签名密钥;本地可用默认值,长期使用请改成 `openssl rand -hex 32`
AUTH_SECRET=adp-dev-insecure-secret-change-me

# 可选 LLM(OpenAI 兼容);留空则 AI 接口走启发式实现
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GPU(本地有 NVIDIA 显卡时开启,让 GPU/hf_model/vllm 类算子转 ready)
# DJ_EXTRAS 装 data-juicer 的 generic extra(torch/transformers/vllm/cudf 等,镜像 +几 GB);
# 机器没有 GPU:把 DJ_EXTRAS 留空、GPU_COUNT 设为 0,并删掉 docker-compose.local.yml 里
# backend 的 deploy.resources.reservations.devices 整段(否则 up 会因找不到 GPU 报错)。
DJ_EXTRAS=[generic]
GPU_COUNT=all
