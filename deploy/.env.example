# 复制为 deploy/.env 后按需修改(deploy/.env 不入库)。
# PostgreSQL(生产请改强密码)
PG_USER=adp
PG_PASSWORD=adp_dev_pw
PG_DB=adp

# 对外 Web 端口(目标机 80 空闲)
WEB_PORT=80

# 引擎并发:单 job 内并行度 / 多 job 并发上限(按 4 核机适配)
ENGINE_NP=2
ENGINE_CONCURRENCY=3

# 允许的跨域来源(JSON 数组;同源部署可不改)
CORS_ORIGINS=["http://10.60.1.60"]

# 会话令牌签名密钥(#5 访问安全):生产务必改成强随机值,如 `openssl rand -hex 32`
# 留空会回退源码内 dev 默认(公开,可被伪造令牌)
AUTH_SECRET=

# 文件管理(平台 MinIO 对象存储);留空则文件管理接口返回 503「未配置」
STORAGE_MINIO_ENDPOINT=http://10.60.1.60:9000
STORAGE_MINIO_ACCESS_KEY=adpadmin
STORAGE_MINIO_SECRET_KEY=adpMinio#2026

# 可选 LLM(OpenAI 兼容);留空则 AI 接口走启发式实现
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
