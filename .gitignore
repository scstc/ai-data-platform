# 外部克隆的子项目，不纳入本仓库版本管理
/data-juicer/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
deploy/.env.gov

# Python 包构建产物(setuptools/uv 自动生成),勿入库
/backend/*.egg-info/

# IDE / OS
.idea/
.vscode/
.DS_Store

# oh-my-claudecode 工具本机会话状态
.omc/
.playwright-mcp/

# 本机专属笔记(部署坑/环境差异等),不入库
CLAUDE.local.md

# 含明文凭证(SSH/DB 密码等)的本地运维文档,不纳入版本管理
# (脱敏版若要进仓库,另起文件名,避免被本规则忽略)
/docs/数据库安装信息汇总*.md

# scripts 跑出的临时 JSON(由 parse_op_docs / render_op_demos 生成)
/backend/scripts/_op_demos.json
/backend/scripts/_media_demos.json
deploy/.env.local
# /adp-start-for-wsl 从 docker-compose.local.yml 派生的 WSL 专用编排(剥 GPU 段 + DJ_EXTRAS 置空)
deploy/docker-compose.local.wsl.yml
